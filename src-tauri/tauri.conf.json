{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tarım Market Pro",
  "version": "1.2.0",
  "identifier": "com.tarimmarket.pro",
  "build": {
    "frontendDist": "../dist/tarim-market/browser",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tarım Market Pro",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob: mediastream:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebaseapp.com https://*.cloudfunctions.net https://api.met.no; frame-src https://*.firebaseapp.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": {
          "tr-TR": {
            "localePath": "wix/tr-TR.wxl"
          }
        }
      },
      "nsis": {
        "languages": [
          "Turkish"
        ],
        "installMode": "currentUser"
      }
    },
    "publisher": "Tarım Market Pro",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDQTI1NUM1QkIwNUEzMjEKUldRaG93Vzd4VldpckFUd1NOb1dmV2RDR0VPNGJudG9zY3hGcE5oMW9XYXN4RXpYU051R3dpUkoK",
      "endpoints": [
        "https://github.com/furkan0rhan/agaoglu/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
