{
  "name": "tarim-market",
  "version": "1.3.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "dev": "ng serve --port 1420",
    "release": "node scripts/release.mjs",
    "lint": "ng lint",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "test:ci": "ng test --watch=false",
    "emu": "node scripts/emulator/firebase.mjs emulators:start --only auth,firestore,ui --project demo-tarim-market --import=.emulator-data --export-on-exit=.emulator-data",
    "emu:seed": "node scripts/emulator/seed.mjs",
    "emu:export": "node scripts/emulator/firebase.mjs emulators:export .emulator-data --force --project demo-tarim-market",
    "dev:emu": "ng serve --configuration emulator --port 4200",
    "test:rules": "node scripts/emulator/firebase.mjs emulators:exec --config scripts/emulator/firebase.rules-test.json --only firestore --project demo-tarim-rules \"vitest run --config vitest.rules.config.ts\""
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/cdk": "^21.2.11",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@ngrx/signals": "^21.1.0",
    "@primeuix/themes": "^2.0.3",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-barcode-scanner": "~2.4.6",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.12.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "chart.js": "^4.5.1",
    "driver.js": "~1.9.0",
    "fflate": "^0.8.2",
    "firebase": "^12.13.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tauri-apps/cli": "^2.11.2",
    "angular-eslint": "^21.4.0",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.8"
  }
}
